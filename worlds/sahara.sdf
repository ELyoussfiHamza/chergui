<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chergui: Sahara world at Merzouga (Erg Chebbi), Morocco.

  Differences from PX4's default world:
  - spherical_coordinates: Erg Chebbi near Merzouga. Chergui overrides this per run with the
    scenario's location (PX4_HOME_LAT/LON/ALT), so GPS, maps and logs are in Morocco.
  - magnetic_field: Earth's field at Merzouga (WMM, ~42 µT, inclination ~41°) instead of Zurich's,
    so the magnetometer agrees with what PX4 expects for this GPS position.
  - atmosphere: 45 °C air at ~715 m elevation.
  - sand-coloured ground, hazy desert sky, low afternoon sun.

  No <plugin> tags on purpose: Gazebo then loads PX4's server.config (physics, sensors,
  NavSat, and ApplyLinkWrench, which Chergui uses to push wind and gusts onto the drone).
-->
<sdf version="1.9">
  <world name="sahara">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.79</gravity>
    <!-- ENU, tesla: east, north, up -->
    <magnetic_field>-2e-07 3.2e-05 -2.8e-05</magnetic_field>
    <atmosphere type="adiabatic">
      <temperature>318.15</temperature>
      <pressure>93200</pressure>
    </atmosphere>
    <scene>
      <grid>false</grid>
      <ambient>0.55 0.48 0.40 1</ambient>
      <background>0.93 0.80 0.62 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>1 1</size></plane>
          </geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>2000 2000</size></plane>
          </geometry>
          <material>
            <ambient>0.86 0.66 0.42 1</ambient>
            <diffuse>0.86 0.66 0.42 1</diffuse>
            <specular>0.1 0.08 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.2</intensity>
      <direction>-0.6 0.3 -0.45</direction>
      <diffuse>1.0 0.86 0.66 1</diffuse>
      <specular>0.35 0.30 0.22 1</specular>
      <attenuation><range>2000</range><linear>0</linear><constant>1</constant><quadratic>0</quadratic></attenuation>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>31.1330</latitude_deg>
      <longitude_deg>-3.9790</longitude_deg>
      <elevation>760</elevation>
    </spherical_coordinates>
  </world>
</sdf>
